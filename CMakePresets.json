{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "environment": {
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "environment": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:$penv{PATH}",
                "PKG_CONFIG_PATH": "/opt/homebrew/lib/pkgconfig:/usr/local/lib/pkgconfig:$penv{PKG_CONFIG_PATH}"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{HOMEBREW_PREFIX};/opt/homebrew;/usr/local"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-x64-base",
            "hidden": true,
            "inherits": "windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "environment": {
                "PATH": "$penv{PATH}",
                "INCLUDE": "$penv{INCLUDE}",
                "LIB": "$penv{LIB}",
                "LIBPATH": "$penv{LIBPATH}"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_LINKER": "link.exe",
                "CMAKE_AR": "lib.exe",
                "CMAKE_RC_COMPILER": "rc.exe",
                "CMAKE_MT": "mt.exe"
            }
        },
        {
            "name": "windows-x86-base",
            "hidden": true,
            "inherits": "windows-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "environment": {
                "PATH": "$penv{PATH}",
                "INCLUDE": "$penv{INCLUDE}",
                "LIB": "$penv{LIB}",
                "LIBPATH": "$penv{LIBPATH}"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_LINKER": "link.exe",
                "CMAKE_AR": "lib.exe",
                "CMAKE_RC_COMPILER": "rc.exe",
                "CMAKE_MT": "mt.exe"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "x64 Debug",
            "inherits": "windows-x64-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-relwithdebinfo",
            "displayName": "x64 RelWithDebInfo",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "x86-debug",
            "displayName": "x86 Debug",
            "inherits": "windows-x86-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x86-release",
            "displayName": "x86 Release",
            "inherits": "x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-debug",
            "displayName": "macOS Debug",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS Release",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "Android arm64-v8a Player (see docs/shipping.md (Android))",
            "description": "Cross-compiles the Player as libmain.so for SDL's Android Java glue. Needs VCPKG_ROOT and ANDROID_NDK_HOME (NDK r27+). Builds; not yet run on a device.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-android-prismatix",
                "VCPKG_HOST_TRIPLET": "x64-windows",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg/triplets",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static",
                "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON",
                "BUILD_TESTING": "OFF",
                "PRISMATIX_SHADERCROSS_EXECUTABLE": "${sourceDir}/out/build/${presetName}/vcpkg_installed/x64-windows/tools/sdl3-shadercross/shadercross.exe"
            }
        },
        {
            "name": "wasm-preview",
            "displayName": "Emscripten Studio Preview",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/wasm-preview",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": "OFF",
                "PRISMATIX_BUILD_WASM_PREVIEW": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "x64-relwithdebinfo",
            "configurePreset": "x64-relwithdebinfo",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "x86-debug",
            "configurePreset": "x86-debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "x86-release",
            "configurePreset": "x86-release",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "inheritConfigureEnvironment": true
        },
        {
            "name": "android-arm64",
            "configurePreset": "android-arm64",
            "targets": ["PrismatiXPlayer"]
        },
        {
            "name": "wasm-preview",
            "configurePreset": "wasm-preview",
            "inheritConfigureEnvironment": true,
            "targets": ["PrismatiXPreviewWasm"]
        }
    ]
}
