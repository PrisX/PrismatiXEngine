{
  "name": "prismatix-engine",
  "version": "1.0.0",
  "dependencies": [
    "fmt",
    "sdl3",
    {
      "name": "sdl3-image",
      "features": ["png", "jpeg", "webp"]
    },
    {
      "name": "sdl3-ttf",
      "features": ["harfbuzz"]
    },
    {
      "name": "sdl3-mixer",
      "features": ["mpg123", "libvorbis", "opusfile", "libflac"]
    },
    "nlohmann-json",
    "spdlog",
    "mbedtls",
    "zstd",
    "ffmpeg"
  ]
}
