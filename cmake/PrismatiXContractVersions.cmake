# Authoritative revisions for public PrismatiX wire contracts.
#
# Templates and the generated C++ header consume these values. Do not duplicate
# public revision numbers in manifests or source headers.
set(PRISMATIX_ENGINE_VERSION 0.1.0)
if(NOT PRISMATIX_ENGINE_VERSION MATCHES "^([0-9]+)\.([0-9]+)\.([0-9]+)$")
    message(FATAL_ERROR "PRISMATIX_ENGINE_VERSION must be MAJOR.MINOR.PATCH")
endif()
set(PRISMATIX_ENGINE_VERSION_MAJOR ${CMAKE_MATCH_1})
set(PRISMATIX_ENGINE_VERSION_MINOR ${CMAKE_MATCH_2})
set(PRISMATIX_ENGINE_VERSION_PATCH ${CMAKE_MATCH_3})
set(PRISMATIX_CHARACTER_RESOURCES_CONTRACT_REVISION 1)
set(PRISMATIX_GAME_CATALOG_RESOURCES_CONTRACT_REVISION 1)
set(PRISMATIX_PACKAGER_CONTRACT_REVISION 1)
set(PRISMATIX_RUNTIME_IR_CONTRACT_REVISION 1)
set(PRISMATIX_UI_CONTRACT_REVISION 1)
set(PRISMATIX_UI_TYPE_REGISTRY_SCHEMA_REVISION 1)
set(PRISMATIX_UI_TYPE_REGISTRY_CONTRACT_REVISION 1)
set(PRISMATIX_PREVIEW_SCHEMA_REVISION 1)
