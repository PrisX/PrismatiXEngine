{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "@prismatix/authoring-sdk",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "outDir": "../out/docs-examples",
    "rootDir": "examples",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["examples/*.ts", "examples/*.tsx"]
}
