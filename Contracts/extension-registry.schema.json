{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prismatix.dev/contracts/extension-registry.schema.json",
  "title":"PrismatiX extension registry HTTP API v1",
  "description":"JSON bodies of the /v1 registry routes (docs/extensions-sharing.md). Clients ignore unknown properties, so a registry may add its own. URLs (download, icon, screenshots, uploadUrl) may be relative; they resolve against the URL of the document that holds them.",
  "$defs":{
    "id":{"$ref":"https://prismatix.dev/contracts/extension-package.schema.json#/$defs/packageId"},
    "versionNumber":{"$ref":"https://prismatix.dev/contracts/extension-package.schema.json#/$defs/version"},
    "urlReference":{"type":"string","minLength":1,"maxLength":2048},
    "timestamp":{"type":"string","maxLength":64},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "capabilities":{"type":"array","uniqueItems":true,"maxItems":64,"items":{"type":"string","maxLength":64}},
    "platforms":{"type":"array","uniqueItems":true,"maxItems":8,"items":{"$ref":"https://prismatix.dev/contracts/extension.schema.json#/$defs/platform"},
      "description":"The platforms an extension runs on; absent means every platform (a JavaScript-only extension)."},
    "platformDownload":{
      "type":"object","required":["download","sha256","size"],
      "properties":{"download":{"$ref":"#/$defs/urlReference"},"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":1}}
    },
    "platformPackage":{
      "type":"object","additionalProperties":false,"required":["sha256","size"],
      "properties":{"sha256":{"$ref":"#/$defs/sha256"},"size":{"type":"integer","minimum":1}}
    },
    "platformUpload":{
      "type":"object","required":["uploadUrl"],
      "properties":{
        "uploadUrl":{"$ref":"#/$defs/urlReference"},
        "uploadMethod":{"const":"PUT"},
        "uploadHeaders":{"type":"object","maxProperties":32,"additionalProperties":{"type":"string","maxLength":4096}}
      }
    },
    "searchResult":{
      "type":"object","required":["id","latestVersion","requiredEngineVersion","capabilities"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "owner":{"type":"string"},"name":{"type":"string"},
        "displayName":{"type":"string","maxLength":128},
        "description":{"type":"string","maxLength":1024},
        "latestVersion":{"$ref":"#/$defs/versionNumber"},
        "requiredEngineVersion":{"type":"string","minLength":1,"maxLength":128},
        "capabilities":{"$ref":"#/$defs/capabilities"},
        "platforms":{"$ref":"#/$defs/platforms"},
        "native":{"type":"boolean"},
        "keywords":{"type":"array","items":{"type":"string","maxLength":32}},
        "icon":{"$ref":"#/$defs/urlReference"},
        "downloads":{"type":"integer","minimum":0},
        "updatedAt":{"$ref":"#/$defs/timestamp"}
      }
    },
    "searchResponse":{
      "type":"object","required":["results","total","page","pageSize"],
      "properties":{
        "query":{"type":"string"},
        "results":{"type":"array","items":{"$ref":"#/$defs/searchResult"}},
        "total":{"type":"integer","minimum":0},
        "page":{"type":"integer","minimum":1},
        "pageSize":{"type":"integer","minimum":1}
      }
    },
    "versionSummary":{
      "type":"object","required":["version","requiredEngineVersion","yanked"],
      "properties":{
        "version":{"$ref":"#/$defs/versionNumber"},
        "requiredEngineVersion":{"type":"string","minLength":1,"maxLength":128},
        "yanked":{"type":"boolean"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "size":{"type":"integer","minimum":0},
        "platforms":{"$ref":"#/$defs/platforms"},
        "publishedAt":{"$ref":"#/$defs/timestamp"}
      }
    },
    "extension":{
      "type":"object","required":["id","capabilities","versions"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "owner":{"type":"string"},"name":{"type":"string"},
        "displayName":{"type":"string","maxLength":128},
        "description":{"type":"string","maxLength":1024},
        "author":{"$ref":"https://prismatix.dev/contracts/extension-package.schema.json#/$defs/author"},
        "license":{"type":"string","maxLength":128},
        "homepage":{"$ref":"#/$defs/urlReference"},
        "repository":{"$ref":"#/$defs/urlReference"},
        "keywords":{"type":"array","items":{"type":"string","maxLength":32}},
        "icon":{"$ref":"#/$defs/urlReference"},
        "screenshots":{"type":"array","items":{"$ref":"#/$defs/urlReference"}},
        "capabilities":{"$ref":"#/$defs/capabilities"},
        "platforms":{"$ref":"#/$defs/platforms"},
        "native":{"type":"boolean"},
        "latestVersion":{"oneOf":[{"$ref":"#/$defs/versionNumber"},{"type":"null"}]},
        "versions":{"type":"array","items":{"$ref":"#/$defs/versionSummary"}},
        "downloads":{"type":"integer","minimum":0},
        "createdAt":{"$ref":"#/$defs/timestamp"},
        "updatedAt":{"$ref":"#/$defs/timestamp"}
      }
    },
    "version":{
      "type":"object","required":["version","requiredEngineVersion","sha256","size","download","manifest","yanked"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "version":{"$ref":"#/$defs/versionNumber"},
        "requiredEngineVersion":{"type":"string","minLength":1,"maxLength":128},
        "sha256":{"$ref":"#/$defs/sha256"},
        "size":{"type":"integer","minimum":1},
        "download":{"$ref":"#/$defs/urlReference"},
        "manifest":{"$ref":"https://prismatix.dev/contracts/extension.schema.json"},
        "metadata":{"$ref":"https://prismatix.dev/contracts/extension-package.schema.json"},
        "platforms":{"$ref":"#/$defs/platforms"},
        "platformDownloads":{"type":"object","maxProperties":8,"propertyNames":{"$ref":"https://prismatix.dev/contracts/extension.schema.json#/$defs/nativePlatform"},"additionalProperties":{"$ref":"#/$defs/platformDownload"},
          "description":"The native pack of each platform, for an extension with native libraries."},
        "yanked":{"type":"boolean"},
        "yankedReason":{"type":"string","maxLength":1024},
        "publishedAt":{"$ref":"#/$defs/timestamp"}
      }
    },
    "publishRequest":{
      "type":"object","additionalProperties":false,"required":["id","version","sha256","size","manifest","metadata"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},
        "version":{"$ref":"#/$defs/versionNumber"},
        "sha256":{"$ref":"#/$defs/sha256"},
        "size":{"type":"integer","minimum":1},
        "manifest":{"$ref":"https://prismatix.dev/contracts/extension.schema.json"},
        "metadata":{"$ref":"https://prismatix.dev/contracts/extension-package.schema.json"},
        "platformPackages":{"type":"object","maxProperties":8,"propertyNames":{"$ref":"https://prismatix.dev/contracts/extension.schema.json#/$defs/nativePlatform"},"additionalProperties":{"$ref":"#/$defs/platformPackage"}}
      }
    },
    "publishResponse":{
      "type":"object","required":["uploadId","uploadUrl"],
      "properties":{
        "uploadId":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},
        "uploadUrl":{"$ref":"#/$defs/urlReference"},
        "uploadMethod":{"const":"PUT"},
        "uploadHeaders":{"type":"object","maxProperties":32,"additionalProperties":{"type":"string","maxLength":4096}},
        "expiresAt":{"$ref":"#/$defs/timestamp"},
        "platformUploads":{"type":"object","maxProperties":8,"propertyNames":{"$ref":"https://prismatix.dev/contracts/extension.schema.json#/$defs/nativePlatform"},"additionalProperties":{"$ref":"#/$defs/platformUpload"},
          "description":"Where to PUT each announced native pack (same rules as uploadUrl)."}
      }
    },
    "yankRequest":{
      "type":"object","additionalProperties":false,"required":["yanked"],
      "properties":{"yanked":{"type":"boolean"},"reason":{"type":"string","maxLength":1024}}
    },
    "error":{
      "type":"object","required":["error"],
      "properties":{"error":{"type":"object","required":["code","message"],
        "properties":{"code":{"type":"string","maxLength":128},"message":{"type":"string","maxLength":4096}}}}
    }
  }
}
