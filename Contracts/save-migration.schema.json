{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prismatix.dev/contracts/save-migration.schema.json",
  "type":"object","additionalProperties":false,
  "required":["format","schemaRevision","id","from","to","anchor","operations"],
  "properties":{
    "format":{"const":"PrismatiXSaveMigration"},
    "schemaRevision":{"const":2},
    "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
    "from":{"$ref":"#/$defs/version"},
    "to":{"$ref":"#/$defs/version"},
    "anchor":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["policy"],"properties":{"policy":{"const":"preserve"}}},
      {"type":"object","additionalProperties":false,"required":["policy","mappings"],"properties":{"policy":{"const":"map"},"mappings":{"type":"array","minItems":1,"maxItems":100000,"items":{"type":"object","additionalProperties":false,"required":["from","to"],"properties":{"from":{"$ref":"#/$defs/anchor"},"to":{"$ref":"#/$defs/anchor"}}}}}}
    ]},
    "operations":{"type":"array","maxItems":100000,"items":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["op","from","to"],"properties":{"op":{"const":"renameVariable"},"from":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"to":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"}}},
      {"type":"object","additionalProperties":false,"required":["op","name"],"properties":{"op":{"const":"removeVariable"},"name":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"}}},
      {"type":"object","additionalProperties":false,"required":["op","name","value"],"properties":{"op":{"const":"setVariable"},"name":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"value":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/jsonValue"}}},
      {"type":"object","additionalProperties":false,"required":["op","from","to"],"properties":{"op":{"const":"renameRoute"},"from":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"to":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"}}},
      {"type":"object","additionalProperties":false,"required":["op","path"],"properties":{"op":{"const":"setScript"},"path":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"}}}
    ]}}
  },
  "$defs":{
    "version":{"type":"object","additionalProperties":false,"required":["contentVersion","saveVersion"],"properties":{"contentVersion":{"type":"string","minLength":1,"maxLength":128},"saveVersion":{"type":"integer","minimum":1,"maximum":1000000}}},
    "anchor":{"type":"object","additionalProperties":false,"required":["runtimeDocumentId","sourceId","operationId"],"properties":{"runtimeDocumentId":{"type":"string","minLength":1,"maxLength":512},"sourceId":{"type":"string","minLength":1,"maxLength":512},"operationId":{"type":"string","minLength":1,"maxLength":512}}}
  }
}
