{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismatix.dev/contracts/motion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaRevision", "id", "canvas", "duration", "loop", "layers", "tracks"],
  "properties": {
    "format": {"const": "PrismatiXMotion"},
    "schemaRevision": {"enum": [1, 2, 3, 4, 5]},
    "id": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
    "canvas": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 16384},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 16384}
      }
    },
    "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
    "loop": {"type": "boolean"},
    "scaleMode": {"enum": ["fit", "fill", "stretch"]},
    "layers": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "image", "width", "height"],
        "properties": {
          "id": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
          "parent": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
          "image": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},
          "frames": {
            "type": "array", "minItems": 1, "maxItems": 4096,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "integer", "minimum": 0, "maximum": 16384},
                "y": {"type": "integer", "minimum": 0, "maximum": 16384},
                "width": {"type": "integer", "minimum": 1, "maximum": 16384},
                "height": {"type": "integer", "minimum": 1, "maximum": 16384}
              }
            }
          },
          "z": {"type": "integer", "minimum": -100000, "maximum": 100000},
          "blendMode": {"enum": ["normal", "additive", "multiply"]},
          "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 16384},
          "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 16384},
          "anchorX": {"type": "number", "minimum": 0, "maximum": 1},
          "anchorY": {"type": "number", "minimum": 0, "maximum": 1},
          "x": {"type": "number", "minimum": -1000000, "maximum": 1000000},
          "y": {"type": "number", "minimum": -1000000, "maximum": 1000000},
          "scaleX": {"type": "number", "minimum": -1000, "maximum": 1000},
          "scaleY": {"type": "number", "minimum": -1000, "maximum": 1000},
          "rotation": {"type": "number", "minimum": -1000000, "maximum": 1000000},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "visible": {"type": "boolean"}
        }
      }
    },
    "tracks": {
      "type": "array", "maxItems": 65536,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["layer", "property", "keys"],
        "properties": {
          "layer": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
          "property": {"enum": ["x", "y", "scaleX", "scaleY", "rotation", "opacity", "visible", "frame"]},
          "keys": {
            "type": "array", "minItems": 1, "maxItems": 65536,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["time", "value", "curve"],
              "properties": {
                "time": {"type": "number", "minimum": 0},
                "value": {"oneOf": [{"type": "number"}, {"type": "boolean"}]},
                "curve": {"enum": ["step", "linear", "easeIn", "easeOut", "easeInOut", "cubicBezier"]},
                "bezier": {
                  "type": "object", "additionalProperties": false,
                  "required": ["x1", "y1", "x2", "y2"],
                  "properties": {
                    "x1": {"type": "number", "minimum": 0, "maximum": 1},
                    "y1": {"type": "number", "minimum": -8, "maximum": 8},
                    "x2": {"type": "number", "minimum": 0, "maximum": 1},
                    "y2": {"type": "number", "minimum": -8, "maximum": 8}
                  }
                }
              },
              "allOf": [{
                "if": {"properties": {"curve": {"const": "cubicBezier"}}},
                "then": {"properties": {"bezier": true}, "required": ["bezier"]},
                "else": {"properties": {"bezier": false}}
              }]
            }
          }
        }
      }
    },
    "markers": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "time", "audio", "bus"],
        "properties": {
          "id": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
          "time": {"type": "number", "minimum": 0},
          "audio": {"$ref": "https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},
          "bus": {"enum": ["se", "voice"]}
        }
      }
    }
  },
  "allOf": [{
    "if": {"type": "object", "properties": {"schemaRevision": {"const": 1}}},
    "then": {"type": "object", "properties": {
      "layers": {"type": "array", "items": {"type": "object", "properties": {"frames": false}}},
      "tracks": {"type": "array", "items": {"type": "object", "properties": {"property": {"not": {"const": "frame"}}}}}
    }}
  }, {
    "if": {"type": "object", "properties": {"schemaRevision": {"enum": [1, 2]}}},
    "then": {"type": "object", "properties": {"markers": false}}
  }, {
    "if": {"type": "object", "properties": {"schemaRevision": {"enum": [1, 2, 3]}}},
    "then": {"type": "object", "properties": {
      "layers": {"type": "array", "items": {"type": "object", "properties": {"blendMode": false}}}
    }}
  }, {
    "if": {"type": "object", "properties": {"schemaRevision": {"enum": [1, 2, 3, 4]}}},
    "then": {"type": "object", "properties": {
      "tracks": {"type": "array", "items": {"type": "object", "properties": {
        "keys": {"type": "array", "items": {"type": "object", "properties": {
          "curve": {"not": {"const": "cubicBezier"}}, "bezier": false
        }}}
      }}}
    }}
  }]
}
