        "binds":{"enum":["textSpeed","autoWait","skipUnread","messageWindowOpacity","dimReadText","uiEffects","font","keepSkipAfterChoice","keepAutoAfterChoice","cursorHideDelay","dialogCursorWarp","dockPinned","messageFace"]},
        "scale":{"type":"number"},"offset":{"type":"number"}
