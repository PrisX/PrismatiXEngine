{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismatix.dev/contracts/common.schema.json",
  "$defs": {
    "uuid": {"type":"string","pattern":"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "identifier": {"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "safePath": {"type":"string","minLength":1,"maxLength":4096,"pattern":"^(?!asset:)(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
    "locale": {"type":"string","minLength":2,"maxLength":35,"pattern":"^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "resourceRef": {
      "oneOf": [
        {"$ref":"#/$defs/safePath"},
        {"type":"string","pattern":"^asset:[0-9a-fA-F-]{36}$"},
        {
          "type":"object","additionalProperties":false,
          "required":["id"],
          "properties":{
            "id":{"$ref":"#/$defs/uuid"},
            "path":{"$ref":"#/$defs/safePath"},
            "kind":{"type":"string","minLength":1,"maxLength":64},
            "name":{"type":"string","maxLength":512}
          }
        }
      ]
    },
    "jsonValue": {
      "anyOf":[
        {"type":"null"},{"type":"boolean"},{"type":"integer"},{"type":"number"},{"type":"string","maxLength":1048576},
        {"type":"array","maxItems":100000,"items":{"$ref":"#/$defs/jsonValue"}},
        {"type":"object","maxProperties":100000,"additionalProperties":{"$ref":"#/$defs/jsonValue"}}
      ]
    },
    "sourceSpan": {
      "type":"object","additionalProperties":false,
      "required":["path","startLine","startColumn","endLine","endColumn","startOffset","endOffset"],
      "properties":{
        "path":{"$ref":"#/$defs/safePath"},
        "startLine":{"type":"integer","minimum":1,"maximum":4294967295},
        "startColumn":{"type":"integer","minimum":1,"maximum":4294967295},
        "endLine":{"type":"integer","minimum":1,"maximum":4294967295},
        "endColumn":{"type":"integer","minimum":1,"maximum":4294967295},
        "startOffset":{"type":"integer","minimum":0},
        "endOffset":{"type":"integer","minimum":0}
      }
    },
    "track": {
      "type":"object","additionalProperties":false,
      "required":["id","binding","keyframes"],
      "properties":{
        "id":{"$ref":"#/$defs/identifier"},
        "binding":{
          "type":"object","additionalProperties":false,"required":["kind","target","property"],
          "properties":{
            "kind":{"enum":["stage","ui","camera","text","audio","shader"]},
            "target":{"type":"string","minLength":1,"maxLength":512},
            "property":{"type":"string","minLength":1,"maxLength":512}
          }
        },
        "keyframes":{
          "type":"array","maxItems":100000,"items":{
            "type":"object","additionalProperties":false,"required":["time","value","easing"],
            "properties":{
              "time":{"type":"number","minimum":0},
              "value":{"$ref":"#/$defs/jsonValue"},
              "easing":{"enum":["step","linear","easeIn","easeOut","easeInOut","backOut"]}
            }
          }
        }
      }
    }
  }
}
