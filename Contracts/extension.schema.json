{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prismatix.dev/contracts/extension.schema.json",
  "$defs":{
    "parameter":{
      "type":"object","additionalProperties":false,"required":["name","type"],
      "properties":{
        "name":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},
        "type":{"enum":["null","boolean","integer","number","string","vec2","rect","color","uuid","resource","token","array","object"]},
        "required":{"type":"boolean"},"default":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/jsonValue"},
        "enum":{"type":"array","uniqueItems":true,"maxItems":1024,"items":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/jsonValue"}},
        "range":{"type":"object","additionalProperties":false,"properties":{"minimum":{"type":"number"},"maximum":{"type":"number"},"step":{"type":"number","exclusiveMinimum":0}}},
        "resourceFilter":{"type":"string","maxLength":128,"description":"A media kind (image/*, or an exact type/subtype) or a file-name glob (*.model3.json), or a comma-separated list of them."},
        "optionsFrom":{"$ref":"#/$defs/optionsFrom"},
        "resourceBundle":{"enum":["directory"],"description":"Type resource only: the files the chosen file needs at run time ship with it. directory packages every file in the folder that holds it, subfolders included (a Live2D .model3.json and its .moc3, textures and motions)."},
        "editorHint":{"enum":["default","multiline","enum","color","resource","character","expression","target","preset","hidden","route","node","animation","token"]}
      }
    },
    "optionsFrom":{
      "description":"Where Studio gets a string or token parameter's choices for a dropdown. The engine treats the value as an ordinary string.",
      "oneOf":[
        {"type":"object","additionalProperties":false,"required":["parameter","pointer"],
          "properties":{
            "parameter":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
            "pointer":{"type":"string","maxLength":1024},
            "take":{"enum":["keys","values"]}
          }},
        {"type":"object","additionalProperties":false,"required":["provider"],
          "properties":{"provider":{"type":"string","minLength":1,"maxLength":512}}}
      ]
    },
    "studioPermission":{"enum":["project.read","project.write"]},
    "studioGlob":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[^/\\\\\\[\\]{}]+$"},
    "studioAssetType":{
      "type":"object","additionalProperties":false,"required":["id","displayName","patterns"],
      "properties":{
        "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","minLength":1,"maxLength":512},
        "description":{"type":"string","maxLength":4096},
        "patterns":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/studioGlob"}}
      }
    },
    "studioInspector":{
      "type":"object","additionalProperties":false,"required":["assetType"],
      "properties":{
        "assetType":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","minLength":1,"maxLength":512},
        "description":{"type":"string","maxLength":4096}
      }
    },
    "studioParameterOptions":{
      "type":"object","additionalProperties":false,"required":["id"],
      "properties":{
        "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","minLength":1,"maxLength":512},
        "description":{"type":"string","maxLength":4096}
      }
    },
    "studioImporter":{
      "description":"An Add item in Studio's Assets: the user picks a folder or files, the Studio side says which files to copy where, and Studio copies them after the user confirms.",
      "type":"object","additionalProperties":false,"required":["id","displayName","pick"],
      "properties":{
        "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","minLength":1,"maxLength":512},
        "description":{"type":"string","maxLength":4096},
        "pick":{"enum":["directory","files"]},
        "accept":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":16,"items":{"$ref":"#/$defs/studioGlob"},"description":"pick files only: the file names the picker offers."}
      }
    },
    "studio":{
      "description":"The Studio side (schemaRevision 2): a module PrismatiX Studio loads in a sandboxed frame. It never reaches a game.",
      "type":"object","additionalProperties":false,"required":["entry","requiredStudioVersion"],
      "properties":{
        "entry":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.js$"}]},
        "requiredStudioVersion":{"type":"string","minLength":1,"maxLength":128},
        "permissions":{"type":"array","uniqueItems":true,"maxItems":8,"items":{"$ref":"#/$defs/studioPermission"}},
        "contributes":{
          "type":"object","additionalProperties":false,
          "properties":{
            "assetTypes":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/studioAssetType"}},
            "inspectors":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/studioInspector"}},
            "parameterOptions":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/studioParameterOptions"}},
            "importers":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/studioImporter"}}
          }
        }
      }
    },
    "platform":{"enum":["win32-x64","linux-x64","darwin-x64","darwin-arm64","android-arm64","web"]},
    "nativePlatform":{"enum":["win32-x64","linux-x64","darwin-x64","darwin-arm64","android-arm64"]},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nativeFile":{
      "type":"object","additionalProperties":false,"required":["path"],
      "properties":{
        "path":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "nativeUserFile":{
      "type":"object","additionalProperties":false,"required":["name"],
      "properties":{
        "name":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9_][A-Za-z0-9._+-]*$","not":{"enum":[".",".."]}},
        "hint":{"type":"string","minLength":1,"maxLength":500},
        "sha256s":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/sha256"}}
      }
    },
    "nativeLibrary":{
      "type":"object","additionalProperties":false,"required":["path"],
      "properties":{
        "path":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:dll|so|dylib)$"}]},
        "sha256":{"$ref":"#/$defs/sha256"},
        "signature":{"type":"string","pattern":"^[0-9a-f]{128}$"},
        "files":{"type":"array","uniqueItems":true,"maxItems":32,"items":{"$ref":"#/$defs/nativeFile"}},
        "userFiles":{"type":"array","uniqueItems":true,"maxItems":32,"items":{"$ref":"#/$defs/nativeUserFile"}}
      }
    },
    "native":{
      "type":"object","additionalProperties":false,"required":["abi","services","libraries"],
      "properties":{
        "abi":{"type":"integer","minimum":1,"maximum":65535},
        "services":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":64,"items":{"type":"string","maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"}},
        "publicKey":{"type":"string","pattern":"^04[0-9a-f]{128}$"},
        "libraries":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/nativePlatform"},"additionalProperties":{"$ref":"#/$defs/nativeLibrary"}}
      }
    },
    "safety":{
      "type":"object","additionalProperties":false,
      "required":["previewSafe","deterministic","seekSafe","rollbackSafe"],
      "properties":{"previewSafe":{"type":"boolean"},"deterministic":{"type":"boolean"},"seekSafe":{"type":"boolean"},"rollbackSafe":{"type":"boolean"}}
    }
  },
  "type":"object","additionalProperties":false,
  "required":["format","schemaRevision","id","version","requiredEngineVersion"],
  "allOf":[
    {"if":{"properties":{"schemaRevision":{"const":1}},"required":["schemaRevision"]},
      "then":{"properties":{"language":{},"entry":{},"capabilities":{},"commands":{},"actions":{},"studio":false},
        "required":["language","entry","capabilities","commands","actions"]}},
    {"if":{"properties":{"entry":{}},"required":["entry"]},
      "then":{"properties":{"language":{},"capabilities":{},"commands":{},"actions":{}},
        "required":["language","capabilities","commands","actions"]},
      "else":{"properties":{"studio":{},"modules":false,"native":false,"platforms":false,"safety":false,
        "capabilities":{"type":"array","maxItems":0},"commands":{"type":"array","maxItems":0},"actions":{"type":"array","maxItems":0}},
        "required":["studio"]}}
  ],
  "properties":{
    "format":{"const":"PrismatiXExtension"},"schemaRevision":{"enum":[1,2]},"language":{"enum":["javascript","typescript"]},
    "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"version":{"type":"string","pattern":"^[vV]?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$","maxLength":64},
    "requiredEngineVersion":{"type":"string","minLength":1,"maxLength":128},"entry":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:js|ts)$"}]},
    "modules":{"type":"array","uniqueItems":true,"maxItems":1024,"items":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:js|ts)$"}]}},
    "capabilities":{"type":"array","uniqueItems":true,"maxItems":64,"items":{"enum":["runtime","animation","ui","audio","video","persistence","input","render","raw.mesh","raw.texture","raw.target","native"]}},
    "platforms":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/platform"}},
    "native":{"$ref":"#/$defs/native"},
    "safety":{"$ref":"#/$defs/safety"},
    "commands":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["id","parameters"],"properties":{"id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},"category":{"type":"string","maxLength":256},"await":{"type":"boolean"},"rollback":{"enum":["reversible","boundary","transient"]},"allowAdditionalParameters":{"type":"boolean"},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"safety":{"$ref":"#/$defs/safety"},"parameters":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/parameter"}}}}},
    "actions":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["id","parameters"],"properties":{"id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},"category":{"type":"string","maxLength":256},"reentry":{"enum":["allow","ignoreWhileRunning","restart"]},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"safety":{"$ref":"#/$defs/safety"},"parameters":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/parameter"}}}}},
    "studio":{"$ref":"#/$defs/studio"}
  }
}
