{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://prismatix.dev/contracts/extension.schema.json",
  "$defs":{
    "parameter":{
      "type":"object","additionalProperties":false,"required":["name","type"],
      "properties":{
        "name":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},
        "displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},
        "type":{"enum":["null","boolean","integer","number","string","vec2","rect","color","uuid","resource","token","array","object"]},
        "required":{"type":"boolean"},"default":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/jsonValue"},
        "enum":{"type":"array","uniqueItems":true,"maxItems":1024,"items":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/jsonValue"}},
        "range":{"type":"object","additionalProperties":false,"properties":{"minimum":{"type":"number"},"maximum":{"type":"number"},"step":{"type":"number","exclusiveMinimum":0}}},
        "resourceFilter":{"type":"string","maxLength":128},
        "editorHint":{"enum":["default","multiline","enum","color","resource","character","expression","target","preset","hidden","route","node","animation","token"]}
      }
    },
    "platform":{"enum":["win32-x64","linux-x64","darwin-x64","darwin-arm64","android-arm64","web"]},
    "nativePlatform":{"enum":["win32-x64","linux-x64","darwin-x64","darwin-arm64"]},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nativeFile":{
      "type":"object","additionalProperties":false,"required":["path"],
      "properties":{
        "path":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "nativeLibrary":{
      "type":"object","additionalProperties":false,"required":["path"],
      "properties":{
        "path":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:dll|so|dylib)$"}]},
        "sha256":{"$ref":"#/$defs/sha256"},
        "signature":{"type":"string","pattern":"^[0-9a-f]{128}$"},
        "files":{"type":"array","uniqueItems":true,"maxItems":32,"items":{"$ref":"#/$defs/nativeFile"}}
      }
    },
    "native":{
      "type":"object","additionalProperties":false,"required":["abi","services","libraries"],
      "properties":{
        "abi":{"type":"integer","minimum":1,"maximum":65535},
        "services":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":64,"items":{"type":"string","maxLength":128,"pattern":"^[a-z0-9][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$"}},
        "publicKey":{"type":"string","pattern":"^04[0-9a-f]{128}$"},
        "libraries":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/nativePlatform"},"additionalProperties":{"$ref":"#/$defs/nativeLibrary"}}
      }
    },
    "safety":{
      "type":"object","additionalProperties":false,
      "required":["previewSafe","deterministic","seekSafe","rollbackSafe"],
      "properties":{"previewSafe":{"type":"boolean"},"deterministic":{"type":"boolean"},"seekSafe":{"type":"boolean"},"rollbackSafe":{"type":"boolean"}}
    }
  },
  "type":"object","additionalProperties":false,
  "required":["format","schemaRevision","language","id","version","requiredEngineVersion","entry","capabilities","commands","actions"],
  "properties":{
    "format":{"const":"PrismatiXExtension"},"schemaRevision":{"const":1},"language":{"enum":["javascript","typescript"]},
    "id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"version":{"type":"string","pattern":"^[vV]?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$","maxLength":64},
    "requiredEngineVersion":{"type":"string","minLength":1,"maxLength":128},"entry":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:js|ts)$"}]},
    "modules":{"type":"array","uniqueItems":true,"maxItems":1024,"items":{"allOf":[{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/safePath"},{"type":"string","pattern":"\\.(?:js|ts)$"}]}},
    "capabilities":{"type":"array","uniqueItems":true,"maxItems":64,"items":{"enum":["runtime","animation","ui","audio","video","persistence","input","render","raw.mesh","raw.texture","raw.target","native"]}},
    "platforms":{"type":"array","uniqueItems":true,"minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/platform"}},
    "native":{"$ref":"#/$defs/native"},
    "safety":{"$ref":"#/$defs/safety"},
    "commands":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["id","parameters"],"properties":{"id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},"category":{"type":"string","maxLength":256},"await":{"type":"boolean"},"rollback":{"enum":["reversible","boundary","transient"]},"allowAdditionalParameters":{"type":"boolean"},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"safety":{"$ref":"#/$defs/safety"},"parameters":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/parameter"}}}}},
    "actions":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["id","parameters"],"properties":{"id":{"$ref":"https://prismatix.dev/contracts/common.schema.json#/$defs/identifier"},"displayName":{"type":"string","maxLength":512},"description":{"type":"string","maxLength":4096},"category":{"type":"string","maxLength":256},"reentry":{"enum":["allow","ignoreWhileRunning","restart"]},"capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"safety":{"$ref":"#/$defs/safety"},"parameters":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/parameter"}}}}}
  }
}
