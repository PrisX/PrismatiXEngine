{
  "name": "@prismatix/authoring-sdk",
  "version": "0.1.0",
  "description": "Compiler, validator and JSX UI authoring SDK for PrismatiX visual novel projects.",
  "keywords": [
    "prismatix",
    "visual-novel",
    "vn",
    "pxstory",
    "compiler",
    "authoring"
  ],
  "license": "MIT",
  "author": "owen0924",
  "homepage": "https://github.com/PrisX/PrismatiXEngine/tree/master/packages/authoring-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrisX/PrismatiXEngine.git",
    "directory": "packages/authoring-sdk"
  },
  "bugs": {
    "url": "https://github.com/PrisX/PrismatiXEngine/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./extension-package": {
      "types": "./dist/src/extension-package.d.ts",
      "import": "./dist/src/extension-package.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "import": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "import": "./dist/src/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/src/build-freshness.js --stamp .",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
